    {
      "id": "CPiP16mQ7E7YRu_Xw7f08",
      "type": "text",
      "x": -91.56581032842382,
      "y": 3914.462308907758,
      "width": 660,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBn",
      "roundness": null,
      "seed": 61697507,
      "version": 880,
      "versionNonce": 1050587522,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785130402323,
      "link": null,
      "locked": false,
      "text": "The thing thats actually gonna make this good is caching\n- Track the EV of every hand (no deck needed)\n    Defined before any hands are simulated\n    Cache size totalhands\n    Should be done the by ev_stand function\n    Check before calling any move\n- Track the EV of every dealer hand (deck needed)\n    Cache size dealerhands\n    Every single ev_stand has its own local cache\n    Works the same as player cache\n\nAlso add weighing by remaining deck cards\n\nTODO:\nAsk user if dealer has blackjack after entering A or T if dp\nAt the highest level, loop through 10 cards for player\ncard and dealer card before calling any functions.",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The thing thats actually gonna make this good is caching\n- Track the EV of every hand (no deck needed)\n    Defined before any hands are simulated\n    Cache size totalhands\n    Should be done the by ev_stand function\n    Check before calling any move\n- Track the EV of every dealer hand (deck needed)\n    Cache size dealerhands\n    Every single ev_stand has its own local cache\n    Works the same as player cache\n\nAlso add weighing by remaining deck cards\n\nTODO:\nAsk user if dealer has blackjack after entering A or T if dp\nAt the highest level, loop through 10 cards for player\ncard and dealer card before calling any functions.",
      "autoResize": true,
      "lineHeight": 1.25
    },
