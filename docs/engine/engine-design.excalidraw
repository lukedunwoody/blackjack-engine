      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBs",
      "roundness": null,
      "seed": 540512536,
      "version": 852,
      "versionNonce": 1412467560,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "g0bCGPJFTqKQ2vvLoI2GD",
          "type": "arrow"
        },
        {
          "id": "6-wTh59ngakqJAjuiOirH",
          "type": "arrow"
        },
        {
          "id": "CSuPB-hcaSLvN4snZQt3W",
          "type": "arrow"
        },
        {
          "id": "rlNKdcp57eu-vc01B6zDe",
          "type": "arrow"
        },
        {
          "id": "s-RsDw_hpuUR3XD4L4s1o",
          "type": "arrow"
        }
      ],
      "updated": 1785292745656,
      "link": null,
      "locked": false,
      "text": "generate deck\nask player card 1\nremove card from deck\nask player card 2\nremove card from deck\nask dealer upcard\nremove card from deck\nif dealer peeks and card is A or T\n    ask if blackjack\n    if it is\n        remove that card\n        continue\nrun ev\ngive user best move\nask user for move\nif stand\nelif hit, ask for card and remove\nelif double, ask for card and remove\nelif surrender\nelif split, call this for both 1 card hands",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "generate deck\nask player card 1\nremove card from deck\nask player card 2\nremove card from deck\nask dealer upcard\nremove card from deck\nif dealer peeks and card is A or T\n    ask if blackjack\n    if it is\n        remove that card\n        continue\nrun ev\ngive user best move\nask user for move\nif stand\nelif hit, ask for card and remove\nelif double, ask for card and remove\nelif surrender\nelif split, call this for both 1 card hands",
      "autoResize": true,
      "lineHeight": 1.25
    },
