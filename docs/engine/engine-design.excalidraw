      ],
      "updated": 1785041031752,
      "link": null,
      "locked": false,
      "text": "Before returning EV, wait for all subtrees to finish.\nThen, take the average EV of all sub_entries as your EV.\nEach move has it's own localized cache that frees once\nall subtrees are analyzed.\nIf it's returning from a step that involves appending a\ncard, also weigh them by the amount of cards left in\nthe deck.\nReturn EV.",
      "fontSize": 16,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Before returning EV, wait for all subtrees to finish.\nThen, take the average EV of all sub_entries as your EV.\nEach move has it's own localized cache that frees once\nall subtrees are analyzed.\nIf it's returning from a step that involves appending a\ncard, also weigh them by the amount of cards left in\nthe deck.\nReturn EV.",
      "autoResize": true,
      "lineHeight": 1.25
    },
