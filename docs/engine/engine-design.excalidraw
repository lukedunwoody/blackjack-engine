    {
      "id": "-vXZEeN6ZRmkqAhvIknj8",
      "type": "text",
      "x": -90.69651777027963,
      "y": 4404.9510458974355,
      "width": 473,
      "height": 500,
      "angle": 0,
      "strokeColor": "#1e1e1e",
